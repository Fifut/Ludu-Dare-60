[layer_names]

3d_physics/layer_1="Playfield"
3d_physics/layer_2="Flipper"
3d_physics/layer_3="Bumper"
3d_physics/layer_5="Ball"
3d_physics/layer_9="Lose"

[physics]

common/physics_ticks_per_second=240
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=20
jolt_physics_3d/simulation/position_steps=4
jolt_physics_3d/simulation/penetration_slop=0.01
jolt_physics_3d/limits/temporary_memory_buffer_size=64

[project_time_tracker]

sections/enabled/External=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
anti_aliasing/quality/msaa_2d=1
anti_aliasing/quality/msaa_3d=1
